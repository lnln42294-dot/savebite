{
  "version": 2,
  "builds": [
    { "src": "src/app.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "src/app.js" },
    { "src": "/merchant.html", "dest": "public/merchant.html" },
    { "src": "/(.*)", "dest": "public/index.html" }
  ]
}